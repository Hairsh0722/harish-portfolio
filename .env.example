# -------------------------------------------------------------------
# EmailJS credentials for the Contact form.
# 1. Create a free account at https://www.emailjs.com/
# 2. Add an Email Service (connect the Gmail you want to receive at:
#    harishhari98840@gmail.com) -> copy the Service ID.
# 3. Create an Email Template that uses these variables:
#      {{from_name}}   -> sender's name
#      {{reply_to}}    -> sender's email (set this as the template "Reply-To")
#      {{message}}     -> the message body
#    -> copy the Template ID.
# 4. In Account -> General, copy your Public Key.
# 5. Copy this file to `.env.local` and paste the three values below.
# 6. Restart `npm start` (CRA only reads env vars at startup).
#
# .env.local is gitignored, so your keys stay out of version control.
# For the deployed site, set these same vars in your host / CI environment.
# -------------------------------------------------------------------

REACT_APP_EMAILJS_SERVICE_ID=your_service_id_here
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id_here
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key_here

# -------------------------------------------------------------------
# Firebase — the SHARED Guild Board (everyone sees everyone's pins).
# Leave these blank and the wall falls back to per-browser storage.
#
# Setup (~10 min, free):
# 1. Create a project at https://console.firebase.google.com/
# 2. Build > Firestore Database > Create database (Production mode).
# 3. Project settings > General > "Your apps" > Web app (</>) -> register.
#    Copy the config values into the six vars below.
# 4. Build > Authentication > Get started > enable "Email/Password".
#    Then Authentication > Users > Add user — create YOUR owner account
#    (email + password). Copy that user's "User UID" into
#    REACT_APP_GUILD_OWNER_UID below (this is who may delete pins).
# 5. Firestore > Rules -> paste the contents of firestore.rules (in this
#    repo), replacing PUT-OWNER-UID-HERE with the same UID. Publish.
# 6. Copy this file to `.env.local`, fill the values, restart `npm start`.
#
# The web config keys below are NOT secrets — access is controlled by the
# Firestore rules, not by hiding these values.
# -------------------------------------------------------------------

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_GUILD_OWNER_UID=
